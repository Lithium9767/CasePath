      "type": "array"
    },
    "limiting_case_refs": {
      "items": {
        "$ref": "#/$defs/ScoredReference"
      },
      "title": "Limiting Case Refs",
      "type": "array"
    },
    "boundary_case_refs": {
      "items": {
        "$ref": "#/$defs/ScoredReference"
      },
