{
  "$defs": {
    "RetrievalPath": {
      "additionalProperties": false,
      "description": "一个可解释的图检索路径；节点和边只保存稳定ID或类型。",
      "properties": {
        "node_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 2,
          "title": "Node Ids",
          "type": "array"
        },
        "edge_types": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Edge Types",
          "type": "array"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "source_span_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Span Ids",
          "type": "array"
        }
      },
      "required": [
        "node_ids",
        "edge_types",
        "score"
      ],
      "title": "RetrievalPath",
      "type": "object"
    },
    "ScoreComponent": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "explanation"
      ],
      "title": "ScoreComponent",
      "type": "object"
    },
    "ScoredReference": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "score_components": {
          "items": {
            "$ref": "#/$defs/ScoreComponent"
          },
          "title": "Score Components",
          "type": "array"
        },
        "retrieval_channels": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Retrieval Channels",
          "type": "array"
        },
        "source_span_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Span Ids",
          "type": "array"
        },
        "graph_paths": {
          "items": {
            "$ref": "#/$defs/RetrievalPath"
          },
          "title": "Graph Paths",
          "type": "array"
        }
      },
      "required": [
        "object_id",
        "score"
      ],
      "title": "ScoredReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "default": "1.3",
      "enum": [
        "1.1",
        "1.3"
      ],
      "title": "Contract Version",
      "type": "string"
    },
    "rule_refs": {
      "items": {
        "$ref": "#/$defs/ScoredReference"
      },
      "title": "Rule Refs",
      "type": "array"
    },
    "support_case_refs": {
      "items": {
        "$ref": "#/$defs/ScoredReference"
      },
      "title": "Support Case Refs",
      "type": "array"
    },
    "limiting_case_refs": {
      "items": {
        "$ref": "#/$defs/ScoredReference"
      },
      "title": "Limiting Case Refs",
      "type": "array"
    },
    "boundary_case_refs": {
      "items": {
        "$ref": "#/$defs/ScoredReference"
      },
      "title": "Boundary Case Refs",
      "type": "array"
    },
    "cited_span_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Cited Span Ids",
      "type": "array"
    },
    "degraded": {
      "default": false,
      "title": "Degraded",
      "type": "boolean"
    },
    "degradation_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Degradation Reason"
    }
  },
  "title": "RetrievalBundle",
  "type": "object"
}