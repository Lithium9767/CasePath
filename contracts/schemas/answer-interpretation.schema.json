{
  "$defs": {
    "ConditionEvidence": {
      "additionalProperties": false,
      "description": "一条用户事实对条件映射的作用，不表示最终法律结论。",
      "properties": {
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "relation": {
          "enum": [
            "SUPPORTS",
            "OPPOSES",
            "QUALIFIES"
          ],
          "title": "Relation",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "relation",
        "confidence",
        "reason"
      ],
      "title": "ConditionEvidence",
      "type": "object"
    },
    "ConditionStatus": {
      "enum": [
        "SATISFIED",
        "NOT_SATISFIED",
        "UNKNOWN",
        "CONFLICTING",
        "NOT_APPLICABLE"
      ],
      "title": "ConditionStatus",
      "type": "string"
    },
    "QueryConditionState": {
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ConditionStatus",
          "default": "UNKNOWN"
        },
        "supporting_fact_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Supporting Fact Ids",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ConditionEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "mapping_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Mapping Reasons",
          "type": "array"
        },
        "score_components": {
          "items": {
            "$ref": "#/$defs/ScoreComponent"
          },
          "title": "Score Components",
          "type": "array"
        },
        "last_updated_turn": {
          "default": 0,
          "minimum": 0,
          "title": "Last Updated Turn",
          "type": "integer"
        }
      },
      "required": [
        "condition_id"
      ],
      "title": "QueryConditionState",
      "type": "object"
    },
    "ScoreComponent": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "explanation"
      ],
      "title": "ScoreComponent",
      "type": "object"
    },
    "UserFact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "predicate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "source_turn": {
          "minimum": 0,
          "title": "Source Turn",
          "type": "integer"
        }
      },
      "required": [
        "fact_id",
        "text",
        "source_turn"
      ],
      "title": "UserFact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "P4 返回事实和条件更新，不得替换整个会话或生成最终法律判断。",
  "properties": {
    "contract_version": {
      "default": "1.3",
      "enum": [
        "1.2",
        "1.3"
      ],
      "title": "Contract Version",
      "type": "string"
    },
    "new_facts": {
      "items": {
        "$ref": "#/$defs/UserFact"
      },
      "title": "New Facts",
      "type": "array"
    },
    "condition_updates": {
      "items": {
        "$ref": "#/$defs/QueryConditionState"
      },
      "title": "Condition Updates",
      "type": "array"
    }
  },
  "title": "AnswerInterpretation",
  "type": "object"
}