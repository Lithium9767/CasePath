{
  "$defs": {
    "MaturityLevel": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ],
      "title": "MaturityLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Contract Version",
      "type": "string"
    },
    "provision_id": {
      "minLength": 1,
      "title": "Provision Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "article_no": {
      "pattern": "^[1-9][0-9]*$",
      "title": "Article No",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "book": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Book"
    },
    "sub_book": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sub Book"
    },
    "chapter": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chapter"
    },
    "section": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Section"
    },
    "valid_from": {
      "format": "date",
      "title": "Valid From",
      "type": "string"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    },
    "effective_status": {
      "enum": [
        "effective",
        "repealed",
        "not_yet_effective"
      ],
      "title": "Effective Status",
      "type": "string"
    },
    "jurisdiction": {
      "minLength": 1,
      "title": "Jurisdiction",
      "type": "string"
    },
    "maturity": {
      "$ref": "#/$defs/MaturityLevel",
      "default": "L0"
    },
    "source_span_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Span Ids",
      "type": "array"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    }
  },
  "required": [
    "provision_id",
    "source_id",
    "article_no",
    "title",
    "text",
    "valid_from",
    "effective_status",
    "jurisdiction",
    "source_span_ids",
    "content_hash"
  ],
  "title": "ProvisionRecord",
  "type": "object"
}