{
  "$defs": {
    "ConditionComparison": {
      "additionalProperties": false,
      "description": "同一规则条件上的案例分化指标，供追问和解释共同消费。",
      "properties": {
        "condition_id": {
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "status_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/ConditionStatus"
          },
          "title": "Status Counts",
          "type": "object"
        },
        "condition_entropy": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Condition Entropy",
          "type": "number"
        },
        "outcome_mutual_information": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Outcome Mutual Information",
          "type": "number"
        },
        "expected_information_gain": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Expected Information Gain",
          "type": "number"
        },
        "expected_rank_change": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Expected Rank Change",
          "type": "number"
        },
        "expected_branch_reduction": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Expected Branch Reduction",
          "type": "number"
        },
        "case_disagreement_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Case Disagreement Score",
          "type": "number"
        },
        "rule_condition_discriminativeness": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Rule Condition Discriminativeness",
          "type": "number"
        },
        "support_case_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Support Case Ids",
          "type": "array"
        },
        "limiting_case_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limiting Case Ids",
          "type": "array"
        },
        "boundary_case_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Boundary Case Ids",
          "type": "array"
        },
        "score_components": {
          "items": {
            "$ref": "#/$defs/ScoreComponent"
          },
          "title": "Score Components",
          "type": "array"
        }
      },
      "required": [
        "condition_id"
      ],
      "title": "ConditionComparison",
      "type": "object"
    },
    "ConditionStatus": {
      "enum": [
        "SATISFIED",
        "NOT_SATISFIED",
        "UNKNOWN",
        "CONFLICTING",
        "NOT_APPLICABLE"
      ],
      "title": "ConditionStatus",
      "type": "string"
    },
    "ScoreComponent": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "explanation"
      ],
      "title": "ScoreComponent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "P4案例分化检测的共享结果，避免追问和解释分别重复计算。",
  "properties": {
    "contract_version": {
      "const": "1.3",
      "default": "1.3",
      "title": "Contract Version",
      "type": "string"
    },
    "condition_comparisons": {
      "items": {
        "$ref": "#/$defs/ConditionComparison"
      },
      "title": "Condition Comparisons",
      "type": "array"
    },
    "ranked_condition_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Ranked Condition Ids",
      "type": "array"
    },
    "degraded": {
      "default": false,
      "title": "Degraded",
      "type": "boolean"
    },
    "degradation_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Degradation Reason"
    }
  },
  "title": "ComparisonBundle",
  "type": "object"
}