{"contract_version":"1.1","rule_id":"rule.contract.performance.good_faith.v1","title":"合同全面履行与诚信履行规则","claim_types":["服务合同履行"],"provisions":[{"source_id":"law.prc.civil_code.2021","provision_id":"law.prc.civil_code.2021.article_0509","article_no":"509","title":"中华人民共和国民法典第509条","valid_from":"2021-01-01","valid_to":null}],"conditions":[{"condition_id":"cond.contract_exists","label":"合同关系依法成立并生效","predicate":"待履行或解除前是否存在依法成立并生效的服务合同关系","user_answerable":true,"evidence_types":["书面合同","会员协议","付款凭证","聊天记录"],"source_span_ids":["span.civil-code.509.paragraph-1"]}],"condition_groups":[{"group_id":"group.contract.performance.good_faith.v1.all","label":"规则适用的一般条件","operator":"ALL","member_condition_ids":["cond.contract_exists"]}],"exceptions":[],"consequences":[{"consequence_id":"consequence.perform_as_agreed","consequence_type":"全面履行与附随义务","description":"当事人应按约全面履行，并依诚信原则履行相应附随义务。","source_span_ids":["span.civil-code.509.paragraph-1","span.civil-code.509.paragraph-2"]}],"maturity":"L3","source_spans":[{"span_id":"span.civil-code.509.paragraph-1","source_id":"law.prc.civil_code.2021","section":"第509条","paragraph_id":"article-0509-paragraph-1","start_offset":0,"end_offset":19,"quote":"当事人应当按照约定全面履行自己的义务。"},{"span_id":"span.civil-code.509.paragraph-2","source_id":"law.prc.civil_code.2021","section":"第509条","paragraph_id":"article-0509-paragraph-2","start_offset":20,"end_offset":61,"quote":"当事人应当遵循诚信原则，根据合同的性质、目的和交易习惯履行通知、协助、保密等义务。"}]}
{"contract_version":"1.1","rule_id":"rule.contract.termination.delay_after_demand.v1","title":"迟延履行主要债务且经催告后仍未履行的法定解除规则","claim_types":["服务合同解除与返还"],"provisions":[{"source_id":"law.prc.civil_code.2021","provision_id":"law.prc.civil_code.2021.article_0509","article_no":"509","title":"中华人民共和国民法典第509条","valid_from":"2021-01-01","valid_to":null},{"source_id":"law.prc.civil_code.2021","provision_id":"law.prc.civil_code.2021.article_0563","article_no":"563","title":"中华人民共和国民法典第563条","valid_from":"2021-01-01","valid_to":null},{"source_id":"law.prc.civil_code.2021","provision_id":"law.prc.civil_code.2021.article_0565","article_no":"565","title":"中华人民共和国民法典第565条","valid_from":"2021-01-01","valid_to":null}],"conditions":[{"condition_id":"cond.contract_exists","label":"合同关系依法成立并生效","predicate":"待履行或解除前是否存在依法成立并生效的服务合同关系","user_answerable":true,"evidence_types":["书面合同","会员协议","付款凭证","聊天记录"],"source_span_ids":["span.civil-code.509.paragraph-1"]},{"condition_id":"cond.main_obligation_delayed","label":"主要债务迟延履行","predicate":"经营者是否已经迟延履行合同的主要服务义务","user_answerable":true,"evidence_types":["合同履行期限","预约记录","服务记录","停业通知"],"source_span_ids":["span.civil-code.563.paragraph-1-item-3"]},{"condition_id":"cond.demand_delivered","label":"已经催告履行","predicate":"用户是否已向经营者发出履行催告并能证明送达","user_answerable":true,"evidence_types":["催告函","快递回执","短信","聊天记录"],"source_span_ids":["span.civil-code.563.paragraph-1-item-3"]},{"condition_id":"cond.reasonable_period_expired","label":"合理期限届满后仍未履行","predicate":"催告给予的合理期限是否已届满且经营者仍未履行","user_answerable":true,"evidence_types":["催告内容","送达时间","届满后的服务记录"],"source_span_ids":["span.civil-code.563.paragraph-1-item-3"]}],"condition_groups":[{"group_id":"group.contract.termination.delay_after_demand.v1.all","label":"规则适用的一般条件","operator":"ALL","member_condition_ids":["cond.contract_exists","cond.main_obligation_delayed","cond.demand_delivered","cond.reasonable_period_expired"]}],"exceptions":[],"consequences":[{"consequence_id":"consequence.right_to_terminate_after_demand","consequence_type":"法定解除权","description":"主要债务迟延且经催告后在合理期限内仍未履行时，解除权人取得解除权；未先通知而直接起诉或申请仲裁的，须经法院或仲裁机构确认解除主张，合同才按第565条规定时点发生效力。本规则不判断第564条所涉解除权行使期限。","source_span_ids":["span.civil-code.563.paragraph-1-intro","span.civil-code.563.paragraph-1-item-3","span.civil-code.565.procedure"]}],"maturity":"L3","source_spans":[{"span_id":"span.civil-code.509.paragraph-1","source_id":"law.prc.civil_code.2021","section":"第509条","paragraph_id":"article-0509-paragraph-1","start_offset":0,"end_offset":19,"quote":"当事人应当按照约定全面履行自己的义务。"},{"span_id":"span.civil-code.563.paragraph-1-intro","source_id":"law.prc.civil_code.2021","section":"第563条","paragraph_id":"article-0563-paragraph-1-intro","start_offset":0,"end_offset":19,"quote":"有下列情形之一的，当事人可以解除合同："},{"span_id":"span.civil-code.563.paragraph-1-item-3","source_id":"law.prc.civil_code.2021","section":"第563条","paragraph_id":"article-0563-paragraph-1-item-3","start_offset":80,"end_offset":112,"quote":"（三）当事人一方迟延履行主要债务，经催告后在合理期限内仍未履行；"},{"span_id":"span.civil-code.565.procedure","source_id":"law.prc.civil_code.2021","section":"第565条","paragraph_id":"article-0565-procedure","start_offset":0,"end_offset":215,"quote":"当事人一方依法主张解除合同的，应当通知对方。合同自通知到达对方时解除；通知载明债务人在一定期限内不履行债务则合同自动解除，债务人在该期限内未履行债务的，合同自通知载明的期限届满时解除。对方对解除合同有异议的，任何一方当事人均可以请求人民法院或者仲裁机构确认解除行为的效力。 当事人一方未通知对方，直接以提起诉讼或者申请仲裁的方式依法主张解除合同，人民法院或者仲裁机构确认该主张的，合同自起诉状副本或者仲裁申请书副本送达对方时解除。"}]}
{"contract_version":"1.1","rule_id":"rule.contract.termination.nonperformance.v1","title":"违约致使合同目的不能实现时的法定解除规则","claim_types":["服务合同解除与返还"],"provisions":[{"source_id":"law.prc.civil_code.2021","provision_id":"law.prc.civil_code.2021.article_0509","article_no":"509","title":"中华人民共和国民法典第509条","valid_from":"2021-01-01","valid_to":null},{"source_id":"law.prc.civil_code.2021","provision_id":"law.prc.civil_code.2021.article_0563","article_no":"563","title":"中华人民共和国民法典第563条","valid_from":"2021-01-01","valid_to":null},{"source_id":"law.prc.civil_code.2021","provision_id":"law.prc.civil_code.2021.article_0565","article_no":"565","title":"中华人民共和国民法典第565条","valid_from":"2021-01-01","valid_to":null}],"conditions":[{"condition_id":"cond.contract_exists","label":"合同关系依法成立并生效","predicate":"待履行或解除前是否存在依法成立并生效的服务合同关系","user_answerable":true,"evidence_types":["书面合同","会员协议","付款凭证","聊天记录"],"source_span_ids":["span.civil-code.509.paragraph-1"]},{"condition_id":"cond.performance_impossible","label":"违约行为致使服务合同目的不能实现","predicate":"迟延履行或其他违约行为是否已使约定的主要服务目的不能实现","user_answerable":true,"evidence_types":["永久停业通知","主体注销信息","拒绝履行记录","履行能力证明"],"source_span_ids":["span.civil-code.563.paragraph-1-item-4"]}],"condition_groups":[{"group_id":"group.contract.termination.nonperformance.v1.all","label":"规则适用的一般条件","operator":"ALL","member_condition_ids":["cond.contract_exists","cond.performance_impossible"]}],"exceptions":[{"exception_id":"cond.alternative_performance","label":"存在足以实现合同目的的替代履行","predicate":"替代服务是否符合约定并仍足以实现原合同目的","effect":"例外成立时，不能仅以原履行方案变化认定合同目的不能实现。","source_span_ids":["span.civil-code.563.paragraph-1-item-4"]}],"consequences":[{"consequence_id":"consequence.statutory_termination","consequence_type":"法定解除权","description":"相对方违约致使合同目的不能实现且不存在足以实现该目的的替代履行时，解除权人取得解除权；替代履行状态未知时不得作确定判断，本规则也不表示合同自动解除。未先通知而直接起诉或申请仲裁的，须经法院或仲裁机构确认解除主张，合同才按第565条规定时点发生效力。本规则不判断第564条所涉解除权行使期限。","source_span_ids":["span.civil-code.563.paragraph-1-intro","span.civil-code.563.paragraph-1-item-4","span.civil-code.565.procedure"]}],"maturity":"L3","source_spans":[{"span_id":"span.civil-code.509.paragraph-1","source_id":"law.prc.civil_code.2021","section":"第509条","paragraph_id":"article-0509-paragraph-1","start_offset":0,"end_offset":19,"quote":"当事人应当按照约定全面履行自己的义务。"},{"span_id":"span.civil-code.563.paragraph-1-intro","source_id":"law.prc.civil_code.2021","section":"第563条","paragraph_id":"article-0563-paragraph-1-intro","start_offset":0,"end_offset":19,"quote":"有下列情形之一的，当事人可以解除合同："},{"span_id":"span.civil-code.563.paragraph-1-item-4","source_id":"law.prc.civil_code.2021","section":"第563条","paragraph_id":"article-0563-paragraph-1-item-4","start_offset":113,"end_offset":147,"quote":"（四）当事人一方迟延履行债务或者有其他违约行为致使不能实现合同目的；"},{"span_id":"span.civil-code.565.procedure","source_id":"law.prc.civil_code.2021","section":"第565条","paragraph_id":"article-0565-procedure","start_offset":0,"end_offset":215,"quote":"当事人一方依法主张解除合同的，应当通知对方。合同自通知到达对方时解除；通知载明债务人在一定期限内不履行债务则合同自动解除，债务人在该期限内未履行债务的，合同自通知载明的期限届满时解除。对方对解除合同有异议的，任何一方当事人均可以请求人民法院或者仲裁机构确认解除行为的效力。 当事人一方未通知对方，直接以提起诉讼或者申请仲裁的方式依法主张解除合同，人民法院或者仲裁机构确认该主张的，合同自起诉状副本或者仲裁申请书副本送达对方时解除。"}]}
{"contract_version":"1.1","rule_id":"rule.contract.termination.restitution.v1","title":"合同解除后的终止履行、恢复原状与补救规则","claim_types":["服务合同解除与返还"],"provisions":[{"source_id":"law.prc.civil_code.2021","provision_id":"law.prc.civil_code.2021.article_0565","article_no":"565","title":"中华人民共和国民法典第565条","valid_from":"2021-01-01","valid_to":null},{"source_id":"law.prc.civil_code.2021","provision_id":"law.prc.civil_code.2021.article_0566","article_no":"566","title":"中华人民共和国民法典第566条","valid_from":"2021-01-01","valid_to":null}],"conditions":[{"condition_id":"cond.contract_terminated","label":"合同已经依法解除","predicate":"合同是否已经发生解除效力","user_answerable":true,"evidence_types":["解除通知","送达凭证","解除协议","裁判文书"],"source_span_ids":["span.civil-code.565.procedure","span.civil-code.566.paragraph-1-unperformed"]}],"condition_groups":[{"group_id":"group.contract.termination.restitution.v1.all","label":"规则适用的一般条件","operator":"ALL","member_condition_ids":["cond.contract_terminated"]}],"exceptions":[],"consequences":[{"consequence_id":"consequence.stop_unperformed_obligations","consequence_type":"终止履行","description":"合同解除后，尚未履行的部分终止履行。","source_span_ids":["span.civil-code.566.paragraph-1-unperformed"]},{"consequence_id":"consequence.restitution_or_remedy","consequence_type":"恢复原状或其他补救","description":"已经履行的部分可根据履行情况和合同性质请求恢复原状或采取其他补救措施，并有权请求赔偿损失；该规则不当然等于全额退款。","source_span_ids":["span.civil-code.566.paragraph-1-remedies"]}],"maturity":"L3","source_spans":[{"span_id":"span.civil-code.565.procedure","source_id":"law.prc.civil_code.2021","section":"第565条","paragraph_id":"article-0565-procedure","start_offset":0,"end_offset":215,"quote":"当事人一方依法主张解除合同的，应当通知对方。合同自通知到达对方时解除；通知载明债务人在一定期限内不履行债务则合同自动解除，债务人在该期限内未履行债务的，合同自通知载明的期限届满时解除。对方对解除合同有异议的，任何一方当事人均可以请求人民法院或者仲裁机构确认解除行为的效力。 当事人一方未通知对方，直接以提起诉讼或者申请仲裁的方式依法主张解除合同，人民法院或者仲裁机构确认该主张的，合同自起诉状副本或者仲裁申请书副本送达对方时解除。"},{"span_id":"span.civil-code.566.paragraph-1-unperformed","source_id":"law.prc.civil_code.2021","section":"第566条","paragraph_id":"article-0566-paragraph-1-unperformed","start_offset":0,"end_offset":17,"quote":"合同解除后，尚未履行的，终止履行；"},{"span_id":"span.civil-code.566.paragraph-1-remedies","source_id":"law.prc.civil_code.2021","section":"第566条","paragraph_id":"article-0566-paragraph-1-remedies","start_offset":17,"end_offset":67,"quote":"已经履行的，根据履行情况和合同性质，当事人可以请求恢复原状或者采取其他补救措施，并有权请求赔偿损失。"}]}
{"contract_version":"1.1","rule_id":"rule.service_contract.termination_refund.v1","title":"民法典下一般服务合同解除与费用补救框架","claim_types":["服务合同解除与返还"],"provisions":[{"source_id":"law.prc.civil_code.2021","provision_id":"law.prc.civil_code.2021.article_0509","article_no":"509","title":"中华人民共和国民法典第509条","valid_from":"2021-01-01","valid_to":null},{"source_id":"law.prc.civil_code.2021","provision_id":"law.prc.civil_code.2021.article_0563","article_no":"563","title":"中华人民共和国民法典第563条","valid_from":"2021-01-01","valid_to":null},{"source_id":"law.prc.civil_code.2021","provision_id":"law.prc.civil_code.2021.article_0565","article_no":"565","title":"中华人民共和国民法典第565条","valid_from":"2021-01-01","valid_to":null},{"source_id":"law.prc.civil_code.2021","provision_id":"law.prc.civil_code.2021.article_0566","article_no":"566","title":"中华人民共和国民法典第566条","valid_from":"2021-01-01","valid_to":null}],"conditions":[{"condition_id":"cond.contract_exists","label":"合同关系依法成立并生效","predicate":"待履行或解除前是否存在依法成立并生效的服务合同关系","user_answerable":true,"evidence_types":["书面合同","会员协议","付款凭证","聊天记录"],"source_span_ids":["span.civil-code.509.paragraph-1"]},{"condition_id":"cond.payment_made","label":"用户已经支付服务费用","predicate":"用户是否已为约定服务付款","user_answerable":true,"evidence_types":["付款凭证","发票","会员账户记录"],"source_span_ids":["span.civil-code.566.paragraph-1-remedies"]},{"condition_id":"cond.unperformed_balance","label":"存在未履行服务或未消费余额","predicate":"是否仍有尚未提供的服务或未消费费用","user_answerable":true,"evidence_types":["会员余额","消费记录","课时记录"],"source_span_ids":["span.civil-code.566.paragraph-1-unperformed","span.civil-code.566.paragraph-1-remedies"]},{"condition_id":"cond.performance_impossible","label":"违约行为致使服务合同目的不能实现","predicate":"迟延履行或其他违约行为是否已使约定的主要服务目的不能实现","user_answerable":true,"evidence_types":["永久停业通知","主体注销信息","拒绝履行记录","履行能力证明"],"source_span_ids":["span.civil-code.563.paragraph-1-item-4"]},{"condition_id":"cond.contract_terminated","label":"合同已经依法解除","predicate":"合同是否已经发生解除效力","user_answerable":true,"evidence_types":["解除通知","送达凭证","解除协议","裁判文书"],"source_span_ids":["span.civil-code.565.procedure","span.civil-code.566.paragraph-1-unperformed"]}],"condition_groups":[{"group_id":"group.service_contract.termination_refund.v1.all","label":"规则适用的一般条件","operator":"ALL","member_condition_ids":["cond.contract_exists","cond.payment_made","cond.unperformed_balance","cond.performance_impossible","cond.contract_terminated"]}],"exceptions":[{"exception_id":"cond.alternative_performance","label":"存在足以实现合同目的的替代履行","predicate":"替代服务是否符合约定并仍足以实现原合同目的","effect":"例外成立时，不能仅以原履行方案变化认定合同目的不能实现。","source_span_ids":["span.civil-code.563.paragraph-1-item-4"]}],"consequences":[{"consequence_id":"consequence.service_termination_and_balance_remedy","consequence_type":"解除权与解除后的费用补救","description":"本规则仅覆盖第563条第一款第四项的违约致使合同目的不能实现路径：解除权成立不表示合同自动解除，应依第565条主张并确定生效时点；未先通知而直接起诉或申请仲裁的，须经法院或仲裁机构确认解除主张。存在足以实现合同目的的替代履行时本路径受阻，该事实未知时不得输出确定解除结论。本规则不判断第564条所涉行使期限；有效解除后，可依第566条按履行情况和合同性质处理费用。本规则未纳入预付式消费专项司法解释，不能单独判断迁店等专项解除事由或计算退款金额。","source_span_ids":["span.civil-code.563.paragraph-1-intro","span.civil-code.563.paragraph-1-item-4","span.civil-code.565.procedure","span.civil-code.566.paragraph-1-unperformed","span.civil-code.566.paragraph-1-remedies"]}],"maturity":"L2","source_spans":[{"span_id":"span.civil-code.509.paragraph-1","source_id":"law.prc.civil_code.2021","section":"第509条","paragraph_id":"article-0509-paragraph-1","start_offset":0,"end_offset":19,"quote":"当事人应当按照约定全面履行自己的义务。"},{"span_id":"span.civil-code.563.paragraph-1-intro","source_id":"law.prc.civil_code.2021","section":"第563条","paragraph_id":"article-0563-paragraph-1-intro","start_offset":0,"end_offset":19,"quote":"有下列情形之一的，当事人可以解除合同："},{"span_id":"span.civil-code.563.paragraph-1-item-4","source_id":"law.prc.civil_code.2021","section":"第563条","paragraph_id":"article-0563-paragraph-1-item-4","start_offset":113,"end_offset":147,"quote":"（四）当事人一方迟延履行债务或者有其他违约行为致使不能实现合同目的；"},{"span_id":"span.civil-code.565.procedure","source_id":"law.prc.civil_code.2021","section":"第565条","paragraph_id":"article-0565-procedure","start_offset":0,"end_offset":215,"quote":"当事人一方依法主张解除合同的，应当通知对方。合同自通知到达对方时解除；通知载明债务人在一定期限内不履行债务则合同自动解除，债务人在该期限内未履行债务的，合同自通知载明的期限届满时解除。对方对解除合同有异议的，任何一方当事人均可以请求人民法院或者仲裁机构确认解除行为的效力。 当事人一方未通知对方，直接以提起诉讼或者申请仲裁的方式依法主张解除合同，人民法院或者仲裁机构确认该主张的，合同自起诉状副本或者仲裁申请书副本送达对方时解除。"},{"span_id":"span.civil-code.566.paragraph-1-unperformed","source_id":"law.prc.civil_code.2021","section":"第566条","paragraph_id":"article-0566-paragraph-1-unperformed","start_offset":0,"end_offset":17,"quote":"合同解除后，尚未履行的，终止履行；"},{"span_id":"span.civil-code.566.paragraph-1-remedies","source_id":"law.prc.civil_code.2021","section":"第566条","paragraph_id":"article-0566-paragraph-1-remedies","start_offset":17,"end_offset":67,"quote":"已经履行的，根据履行情况和合同性质，当事人可以请求恢复原状或者采取其他补救措施，并有权请求赔偿损失。"}]}
