# 默认仍运行可离线联调的Demo；正式装配必须显式设置为live。
CASEPATH_MODE=live
CASEPATH_MAX_QUESTION_TURNS=3

# Neo4j。正式部署必须使用数据库侧只读账号，不要复用管理员账号。
CASEPATH_NEO4J_URI=bolt://localhost:7688
CASEPATH_NEO4J_USER=casepath_reader
CASEPATH_NEO4J_PASSWORD=replace-me
CASEPATH_NEO4J_DATABASE=neo4j
CASEPATH_NEO4J_CONNECTION_TIMEOUT_SECONDS=5
CASEPATH_NEO4J_QUERY_TIMEOUT_SECONDS=15
CASEPATH_NEO4J_MAX_RETRY_SECONDS=3

# 仅供 scripts/rebuild_neo4j.py 使用的独立写账号；在线服务不得读取或复用。
CASEPATH_NEO4J_IMPORT_USER=casepath_writer
CASEPATH_NEO4J_IMPORT_PASSWORD=replace-me

# 百炼/OpenAI兼容模型。API Key也可继续使用DASHSCOPE_API_KEY提供。
CASEPATH_LLM_API_KEY=replace-me
CASEPATH_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CASEPATH_LLM_MODEL=qwen-plus
CASEPATH_LLM_TIMEOUT_SECONDS=30
CASEPATH_LLM_MAX_RETRIES=2
CASEPATH_LLM_MAX_COMPLETION_TOKENS=2048
# qwen-plus默认使用兼容面更广的json_object；确认模型支持后可改为json_schema。
CASEPATH_LLM_STRUCTURED_OUTPUT=json_object
