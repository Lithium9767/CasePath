# 复制为 .env 后填入自己的 Key。本示例通过配置化入口启用 Live，旧入口仍是 Demo。
CASEPATH_MODE=live
CASEPATH_MAX_QUESTION_TURNS=3
CASEPATH_DATA_ROOT=data

# Neo4j Aura：URI 用控制台复制的 neo4j+s://...，不要写 localhost。
# 程序不读 Aura 控制台，必须写进本机 .env 或进程环境。
CASEPATH_NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# 在线服务应配置独立只读账号；没有只读账号时不要声称权限隔离已验收。
CASEPATH_NEO4J_USER=casepath_reader
# 不填密码时使用内存图；完成入库及只读账号配置后再填写。
CASEPATH_NEO4J_PASSWORD=
CASEPATH_NEO4J_DATABASE=neo4j
CASEPATH_NEO4J_CONNECTION_TIMEOUT_SECONDS=5
CASEPATH_NEO4J_QUERY_TIMEOUT_SECONDS=15
CASEPATH_NEO4J_MAX_RETRY_SECONDS=3

# 仅供 `python -m casepath.ingestion.graph --import-neo4j` 使用的独立写账号。
# 导入器读取 WRITE_*，不会回退到下面的只读密码。
CASEPATH_NEO4J_WRITE_USER=casepath_writer
CASEPATH_NEO4J_WRITE_PASSWORD=replace-me

# OpenAI 兼容模型。DeepSeek 示例：
# CASEPATH_LLM_BASE_URL=https://api.deepseek.com
# CASEPATH_LLM_MODEL=deepseek-v4-flash
# 百炼则用下面默认地址。API Key 也可继续用 DASHSCOPE_API_KEY。
CASEPATH_LLM_API_KEY=
# true：缺 Key 或初始化失败则拒绝启动；不代表启动时已请求模型验证 Key。
# 如需纯离线 BM25＋内存图联调，可改为 false。
CASEPATH_LLM_REQUIRED=true
CASEPATH_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CASEPATH_LLM_MODEL=qwen-plus
CASEPATH_LLM_TIMEOUT_SECONDS=30
CASEPATH_LLM_MAX_RETRIES=2
CASEPATH_LLM_MAX_COMPLETION_TOKENS=2048
# 上面全局预算只用于无阶段调用；P4 使用各阶段默认预算（默认不重试）。
# 部分覆盖示例；thinking 目前只对官方 DeepSeek 主机发送。
# CASEPATH_LLM_STAGE_POLICIES={"relevance":{"max_tokens":1000,"timeout_seconds":45,"max_retries":0,"thinking":"disabled"},"projection":{"max_tokens":1400},"explanation":{"max_tokens":1800,"timeout_seconds":60}}
# qwen-plus默认使用兼容面更广的json_object；确认模型支持后可改为json_schema。
CASEPATH_LLM_STRUCTURED_OUTPUT=json_object
